      "type": "text",
      "fontSize": 15,
      "fontFamily": 1,
      "text": "If a target replica is down, coordinator may keep a HINT and deliver it later (hinted handoff).",
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 15,
      "containerId": null,
      "originalText": "If a target replica is down, coordinator may keep a HINT and deliver it later (hinted handoff).",
      "lineHeight": 1.35,
      "index": "b1F",
      "autoResize": true
    },
