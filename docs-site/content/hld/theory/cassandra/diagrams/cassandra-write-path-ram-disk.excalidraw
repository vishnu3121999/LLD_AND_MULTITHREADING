      "type": "text",
      "fontSize": 22,
      "fontFamily": 1,
      "text": "CommitLog sync modes",
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 22,
      "containerId": null,
      "originalText": "CommitLog sync modes",
      "lineHeight": 1.35,
