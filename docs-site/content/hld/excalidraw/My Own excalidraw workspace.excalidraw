    {
      "id": "e212zlTWxOpc55ghAjsHs",
      "type": "text",
      "x": 11350.279593382264,
      "y": -61.1050910905287,
      "width": 495,
      "height": 1200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
