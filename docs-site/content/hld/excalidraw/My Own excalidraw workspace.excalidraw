      "text": "Tables:\n\nUser:\n- id (pk)\n- name\n- phone\n- email\n\nNotificationSettings:\n- userId (pk)\n- push\n- phone\n- email\n\nDevice:\n- deviceId (pk)\n- userId (fk)\n- device_token\n\n(Note: A device will have 1 user , \nbut an user can have multiple devices)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tables:\n\nUser:\n- id (pk)\n- name\n- phone\n- email\n\nNotificationSettings:\n- userId (pk)\n- push\n- phone\n- email\n\nDevice:\n- deviceId (pk)\n- userId (fk)\n- device_token\n\n(Note: A device will have 1 user , \nbut an user can have multiple devices)",
      "autoResize": true,
      "lineHeight": 1.25
