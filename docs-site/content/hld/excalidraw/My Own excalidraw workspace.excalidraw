      "versionNonce": 103981908,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762584772674,
      "link": null,
      "locked": false,
      "text": "- POST /api/v1/auth/register \n    body: {\n        username, password, email\n    } \n     -> user_id\n\n- POST /api/v1/auth/login\n    body: { \n        email, password\n    }\n    -> \n    {\n        access_token, refresh_token\n    }\n        \n\n- POST /api/v1/tweets\n  Authorization: Bearer <access_token>\n  body: Tweet\n\n- PATCH /api/v1/tweets/{tweetid}\n  Authorization: Bearer <access_token>\n  body: Tweet\n\n- DELETE /api/v1/tweets/{tweetId}\n  Authorization: Bearer <access_token>\n\n- POST /api/v1/users/{target_userId}/follow\n  Authorization: Bearer <access_token>\n\n- DELETE /api/v1/users/{target_userId}/follow\n  Authorization: Bearer <access_token>\n\n- GET /api/v1/timeline? - TODO\n  Authorization: Bearer <access_token>\n\n- POST /api/v1/tweets/{tweetid}/like\n  Authorization: Bearer <access_token>\n  \n- POST /api/v1/tweets/{tweetid}/reply\n  Authorization: Bearer <access_token>\n  body: { Reply }\n\n- POST /api/v1/tweets/{tweetid}/retweet\n  Authorization: Bearer <access_token>\n  \n- GET /api/v1/tweets?searchKey={} -> Tweet[]\n    ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- POST /api/v1/auth/register \n    body: {\n        username, password, email\n    } \n     -> user_id\n\n- POST /api/v1/auth/login\n    body: { \n        email, password\n    }\n    -> \n    {\n        access_token, refresh_token\n    }\n        \n\n- POST /api/v1/tweets\n  Authorization: Bearer <access_token>\n  body: Tweet\n\n- PATCH /api/v1/tweets/{tweetid}\n  Authorization: Bearer <access_token>\n  body: Tweet\n\n- DELETE /api/v1/tweets/{tweetId}\n  Authorization: Bearer <access_token>\n\n- POST /api/v1/users/{target_userId}/follow\n  Authorization: Bearer <access_token>\n\n- DELETE /api/v1/users/{target_userId}/follow\n  Authorization: Bearer <access_token>\n\n- GET /api/v1/timeline? - TODO\n  Authorization: Bearer <access_token>\n\n- POST /api/v1/tweets/{tweetid}/like\n  Authorization: Bearer <access_token>\n  \n- POST /api/v1/tweets/{tweetid}/reply\n  Authorization: Bearer <access_token>\n  body: { Reply }\n\n- POST /api/v1/tweets/{tweetid}/retweet\n  Authorization: Bearer <access_token>\n  \n- GET /api/v1/tweets?searchKey={} -> Tweet[]\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
