    {
      "id": "4Dw4OgkwKskeZVmkRguhb",
      "type": "text",
      "x": -111.93526358632676,
      "y": 2640.2848562234067,
      "width": 1860.40283203125,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3K",
      "roundness": null,
      "seed": 1285232488,
      "version": 460,
      "versionNonce": 1009211160,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761391635926,
      "link": null,
      "locked": false,
      "text": "1. Above design doesnt work for large files\n    - upload path is redundant, as we upload file to file service first & then it uploads to s3 - waste of CPU & bandwidth on fileservice\n    - there is size limit to request body, often set by clients/servers/api gateways.\n        - AWS managed gateway has a limit of 10MB\n        - so request cant get pass API gateway\n\n    ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Above design doesnt work for large files\n    - upload path is redundant, as we upload file to file service first & then it uploads to s3 - waste of CPU & bandwidth on fileservice\n    - there is size limit to request body, often set by clients/servers/api gateways.\n        - AWS managed gateway has a limit of 10MB\n        - so request cant get pass API gateway\n\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
