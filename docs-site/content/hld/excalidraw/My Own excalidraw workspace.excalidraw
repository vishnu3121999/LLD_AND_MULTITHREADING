      "isDeleted": false,
      "boundElements": [],
      "updated": 1774088994078,
      "link": null,
      "locked": false,
      "text": "SELECT\n    date_trunc('day', ts) AS bucket,\n    AVG(price) AS price\nFROM Price\nWHERE product_id = :product_id\nAND ts >= NOW() - INTERVAL '30 days'\nGROUP BY bucket\nORDER BY bucket;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT\n    date_trunc('day', ts) AS bucket,\n    AVG(price) AS price\nFROM Price\nWHERE product_id = :product_id\nAND ts >= NOW() - INTERVAL '30 days'\nGROUP BY bucket\nORDER BY bucket;",
      "autoResize": true,
      "lineHeight": 1.25
    },
