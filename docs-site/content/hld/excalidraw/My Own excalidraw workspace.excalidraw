    {
      "id": "iczxxcpLo64kFUPvv9Wt2",
      "type": "text",
      "x": 12097.107869442827,
      "y": 751.2750212257246,
      "width": 737,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7Z",
      "roundness": null,
      "seed": 2110324588,
      "version": 692,
      "versionNonce": 114227796,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762614064302,
      "link": null,
      "locked": false,
      "text": "Timeline:\n- User sends get timeline request\n- API Server:\n    - finds the users followed by current user\n    - finds all of their tweets\n    - sorts them by chronological order & returns paginated results\n\nSQL:\n    SELECT t.id, t.content, t.urls, t.timestamp\n    FROM Followers as f\n    INNER JOIN Tweets as t ON f.userId = t.postedBy\n    WHERE f.followerId = :currUser AND t.timestamp > :pageCursor\n    ORDER BY timestamp DESC;\n    LIMIT :limit \n    \n\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Timeline:\n- User sends get timeline request\n- API Server:\n    - finds the users followed by current user\n    - finds all of their tweets\n    - sorts them by chronological order & returns paginated results\n\nSQL:\n    SELECT t.id, t.content, t.urls, t.timestamp\n    FROM Followers as f\n    INNER JOIN Tweets as t ON f.userId = t.postedBy\n    WHERE f.followerId = :currUser AND t.timestamp > :pageCursor\n    ORDER BY timestamp DESC;\n    LIMIT :limit \n    \n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
