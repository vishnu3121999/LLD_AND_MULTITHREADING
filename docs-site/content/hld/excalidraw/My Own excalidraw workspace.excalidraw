      "updated": 1761392167003,
      "link": null,
      "locked": false,
      "text": "API:\n\n- POST /files -> FileMetadata\n  body: File, FileMetaData\n\n- GET /files/{fileId} -> File,FileMetadata\n\n- GET /changes?since={timestamp} -> FileMetadata[]",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API:\n\n- POST /files -> FileMetadata\n  body: File, FileMetaData\n\n- GET /files/{fileId} -> File,FileMetadata\n\n- GET /changes?since={timestamp} -> FileMetadata[]",
      "autoResize": true,
      "lineHeight": 1.25
    },
