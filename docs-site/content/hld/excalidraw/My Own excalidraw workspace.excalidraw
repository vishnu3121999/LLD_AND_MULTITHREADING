    {
      "id": "XuvJtE-f8IB9kyx7Q9mxf",
      "type": "text",
      "x": -6024.552314139358,
      "y": 1981.651379921501,
      "width": 504.14349365234375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b72",
      "roundness": null,
      "seed": 1068693332,
      "version": 269,
      "versionNonce": 1165017324,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761922542901,
      "link": null,
      "locked": false,
      "text": "- Multiple replicas of API server & Notification servers\n- Postgres : \n    - HA configuration ( primary & standbys )\n    - sync replication to standbys \n        - writes will be little slow , but for signups, its acceptable\n    \n  ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Multiple replicas of API server & Notification servers\n- Postgres : \n    - HA configuration ( primary & standbys )\n    - sync replication to standbys \n        - writes will be little slow , but for signups, its acceptable\n    \n  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JDnuTsFF52Gj3ccDEtAkm",
      "type": "text",
      "x": -6037.077760572663,
      "y": 2138.8229495313385,
      "width": 314.6397705078125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b73",
      "roundness": null,
      "seed": 628085612,
      "version": 46,
      "versionNonce": 509334508,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761922463280,
      "link": null,
      "locked": false,
      "text": "- 1B Push Notifications per day:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
