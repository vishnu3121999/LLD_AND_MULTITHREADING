      "link": null,
      "locked": false,
      "text": "1. Creates Alerts in DB\n2. Periodically polls the alerts (every 30s) & for each alert executes its query & notifies if req \n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Creates Alerts in DB\n2. Periodically polls the alerts (every 30s) & for each alert executes its query & notifies if req \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y9h0dPzHqzx8fhsseExFT",
      "type": "text",
      "x": 44157.39749535813,
      "y": 1725.0499295813738,
      "width": 585.1997680664062,
      "height": 210,
      "angle": 0,
