    {
      "id": "3b06d1OogLHB27VCP1IHY",
      "type": "text",
      "x": 16178.990698987283,
      "y": 11518.698169894735,
      "width": 2109.799560546875,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bVh",
      "roundness": null,
      "seed": 1254584622,
      "version": 575,
      "versionNonce": 2119519790,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783074349062,
      "link": null,
      "locked": false,
      "text": "1.Advertisers & Publishers register on Ad network\n2.Client accesses publishers website. Publishers send its website content along with Ad script\n3.Client's browser executes the Ad script i.e it makes a call to Ad network to fetch ads. Ad network finds the best match Ad & returns it\n4.Client clicks on some Ad. Ad network receives that click event , logs it internally & does 302 redirect to advertisers website\n5.Client accesses advertisers website upon redirect\n6. Advertisers can perform analytics ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.Advertisers & Publishers register on Ad network\n2.Client accesses publishers website. Publishers send its website content along with Ad script\n3.Client's browser executes the Ad script i.e it makes a call to Ad network to fetch ads. Ad network finds the best match Ad & returns it\n4.Client clicks on some Ad. Ad network receives that click event , logs it internally & does 302 redirect to advertisers website\n5.Client accesses advertisers website upon redirect\n6. Advertisers can perform analytics ",
      "autoResize": true,
      "lineHeight": 1.25
    },
