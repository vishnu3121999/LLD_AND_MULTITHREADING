      "updated": 1772606241779,
      "link": null,
      "locked": false,
      "text": "locationUpdate():\n    GEOADD locations long lat driverId\n    SET heartbeat:driverId ts EXPIRE 30s\n\ngetNearByDriver():\n    lua script:\n        GEOSEARCH locations FROMLONLAT lon lat BYRADIUS 3 km\n        filter entries which doeshave heartbeat:driverId",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "locationUpdate():\n    GEOADD locations long lat driverId\n    SET heartbeat:driverId ts EXPIRE 30s\n\ngetNearByDriver():\n    lua script:\n        GEOSEARCH locations FROMLONLAT lon lat BYRADIUS 3 km\n        filter entries which doeshave heartbeat:driverId",
      "autoResize": true,
      "lineHeight": 1.25
