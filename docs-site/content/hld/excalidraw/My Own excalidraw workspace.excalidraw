      "index": "b60",
      "roundness": null,
      "seed": 2021932372,
      "version": 326,
      "versionNonce": 439582444,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761921525849,
      "link": null,
      "locked": false,
      "text": "Signup & Notification-settings:\n- clients send req to register by providing user info & \n    notification settings.\n- API servers write it to postgres\n- clients can requests to change the notification-settings as well",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Signup & Notification-settings:\n- clients send req to register by providing user info & \n    notification settings.\n- API servers write it to postgres\n- clients can requests to change the notification-settings as well",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qmQmxzdLDJCnG6YqGXJ-g",
      "type": "text",
      "x": -5272.808980556148,
      "y": 1289.2092135680707,
      "width": 825.4594116210938,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b61",
      "roundness": null,
      "seed": 1934090988,
      "version": 442,
      "versionNonce": 1270661484,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761921525849,
      "link": null,
      "locked": false,
      "text": "Send Notifications:\n- Internal services send notifications to Notification servers\n    by specifying {userId, notiType, payload}\n- Noti Servers check postgres to get the user info (one of - ph, email, device token)\n    & prepares the request for 3rd party services & send.\n- 3rd party services take care of the notification delivery",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Send Notifications:\n- Internal services send notifications to Notification servers\n    by specifying {userId, notiType, payload}\n- Noti Servers check postgres to get the user info (one of - ph, email, device token)\n    & prepares the request for 3rd party services & send.\n- 3rd party services take care of the notification delivery",
      "autoResize": true,
      "lineHeight": 1.25
    },
