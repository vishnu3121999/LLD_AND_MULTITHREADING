      "updated": 1762581151659,
      "link": null,
      "locked": false,
      "text": "Tweets:\n- id (pk)\n- content\n- urls\n- postedBy (fk)\n- timestamp\n\nUsers:\n- id\n- email\n- metadata\n\nFollowers:\n- userId (pk)\n- followerId(pk)\n\nLikes:\n- tweetId (pk)\n- likedBy (pk)\n\nReplies:\n- tweetId (pk)\n- timestamp (pk)\n- repliedBy\n- content\n- urls\n\nRetweet:\n- id (pk)\n- tweetId (fk)\n- retweetBy (fk)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tweets:\n- id (pk)\n- content\n- urls\n- postedBy (fk)\n- timestamp\n\nUsers:\n- id\n- email\n- metadata\n\nFollowers:\n- userId (pk)\n- followerId(pk)\n\nLikes:\n- tweetId (pk)\n- likedBy (pk)\n\nReplies:\n- tweetId (pk)\n- timestamp (pk)\n- repliedBy\n- content\n- urls\n\nRetweet:\n- id (pk)\n- tweetId (fk)\n- retweetBy (fk)",
      "autoResize": true,
      "lineHeight": 1.25
    },
