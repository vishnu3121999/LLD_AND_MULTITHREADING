      "boundElements": [],
      "updated": 1774161513589,
      "link": null,
      "locked": false,
      "text": "SELECT \n    time_bin(INTERVAL :step, ts, TIMESTAMP '1970-01-01') as bucket,\n    count(*) as total_clicks\nFROM clicks\nWHERE adId=:adId AND ts>=:t1 AND ts<=t2\nGROUP BY bucket\nORDER BY bucket;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT \n    time_bin(INTERVAL :step, ts, TIMESTAMP '1970-01-01') as bucket,\n    count(*) as total_clicks\nFROM clicks\nWHERE adId=:adId AND ts>=:t1 AND ts<=t2\nGROUP BY bucket\nORDER BY bucket;",
      "autoResize": true,
      "lineHeight": 1.25
    },
