      "boundElements": [],
      "updated": 1762613069565,
      "link": null,
      "locked": false,
      "text": "- Create account & login\n- Create, edit & delete tweets\n- Follow other users. Each user can follow upto 1k\n- View timeline of tweets from following\n    - only friends, not friend of friends\n    - chronological order\n- Like, reply & retweet\n- search for tweets\n- tweets should support media",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Create account & login\n- Create, edit & delete tweets\n- Follow other users. Each user can follow upto 1k\n- View timeline of tweets from following\n    - only friends, not friend of friends\n    - chronological order\n- Like, reply & retweet\n- search for tweets\n- tweets should support media",
      "autoResize": true,
      "lineHeight": 1.25
    },
