    },
    {
      "id": "xu837ZupcEYXlCGSA20Oc",
      "type": "text",
      "x": -6081.28771591901,
      "y": -142.53495009984647,
      "width": 1093.9593505859375,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b52",
      "roundness": null,
      "seed": 1202069636,
      "version": 347,
      "versionNonce": 1443810284,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761915510522,
      "link": null,
      "locked": false,
      "text": "Types of notifications: \n- push notifications:\n    - Even when the client app is not open, you will receive the notifications.\n    - How?\n        - Even when your app is “closed,” it’s not as if your phone has disappeared from the internet.\n            Your operating system (OS) — Android or iOS — runs a system-level service that keeps a lightweight, \n            persistent connection open to a push notification gateway (Firebase for Android, APNs for iOS, etc.).\n            Your app doesn’t maintain that connection — the OS does, on behalf of all apps.\n    - Android - Firebase Cloud Messaging (FCM)\n    - IOS & MACOS- Apple Push Notifications Service (APNs)\n    - Windows - Windows push notification service\n- SMS\n- Email\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Types of notifications: \n- push notifications:\n    - Even when the client app is not open, you will receive the notifications.\n    - How?\n        - Even when your app is “closed,” it’s not as if your phone has disappeared from the internet.\n            Your operating system (OS) — Android or iOS — runs a system-level service that keeps a lightweight, \n            persistent connection open to a push notification gateway (Firebase for Android, APNs for iOS, etc.).\n            Your app doesn’t maintain that connection — the OS does, on behalf of all apps.\n    - Android - Firebase Cloud Messaging (FCM)\n    - IOS & MACOS- Apple Push Notifications Service (APNs)\n    - Windows - Windows push notification service\n- SMS\n- Email\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
