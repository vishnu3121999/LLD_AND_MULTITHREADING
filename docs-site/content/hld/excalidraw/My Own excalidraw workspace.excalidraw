      "seed": 1139432812,
      "version": 545,
      "versionNonce": 528632148,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762613076983,
      "link": null,
      "locked": false,
      "text": "- No SPOF\n- Availability > Consistency\n- throughput:\n    - 100M+ DAU\n    - 1 tweet per day by user\n- latency:\n    - Reads:\n        - Timeline load : < 500ms\n    - Writes: \n        - Posting tweet can be a bit slower : 500ms-1s\n- should handle celebreties/hot keys\n\n    ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- No SPOF\n- Availability > Consistency\n- throughput:\n    - 100M+ DAU\n    - 1 tweet per day by user\n- latency:\n    - Reads:\n        - Timeline load : < 500ms\n    - Writes: \n        - Posting tweet can be a bit slower : 500ms-1s\n- should handle celebreties/hot keys\n\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
