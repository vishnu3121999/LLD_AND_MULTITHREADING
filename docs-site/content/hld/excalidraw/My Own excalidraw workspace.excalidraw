    },
    {
      "id": "Ua0LjAyPv6BKvhuLybqX_",
      "type": "text",
      "x": 1274.9958538536011,
      "y": 1871.2608943486473,
      "width": 813.4194946289062,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b31",
      "roundness": null,
      "seed": 217313384,
      "version": 888,
      "versionNonce": 1060466536,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761372973254,
      "link": null,
      "locked": false,
      "text": "Upload Path:\n- Client can manually upload from APP GUI or create a file in local folder\n- Incase of \n    - GUI: directly send a post req\n    - Folder: \n            - Windows API : FileSystemWatcher\n            - Mac API: FSEvents\n- LB receives the POST req & forwards to FileService\n- File Service uploads the file to S3 & then creates an entry in FileMetadata DB\n- FileMetadata returned to client & is stored in local Db\n\nDownload Path:\n- Client clicks manually download from APP GUI or click save for offline from folder\n- File Service returns the S3 for the fileId\n- Client downloads the file from S3.\n\nOffline View:\n- Local DB can have a similar table for FileMetadata as that in cloud\n- when offline the upload/download doesnt work, but FileMetadata[] is visible \n    from both app & folder.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Upload Path:\n- Client can manually upload from APP GUI or create a file in local folder\n- Incase of \n    - GUI: directly send a post req\n    - Folder: \n            - Windows API : FileSystemWatcher\n            - Mac API: FSEvents\n- LB receives the POST req & forwards to FileService\n- File Service uploads the file to S3 & then creates an entry in FileMetadata DB\n- FileMetadata returned to client & is stored in local Db\n\nDownload Path:\n- Client clicks manually download from APP GUI or click save for offline from folder\n- File Service returns the S3 for the fileId\n- Client downloads the file from S3.\n\nOffline View:\n- Local DB can have a similar table for FileMetadata as that in cloud\n- when offline the upload/download doesnt work, but FileMetadata[] is visible \n    from both app & folder.",
      "autoResize": true,
      "lineHeight": 1.25
    },
