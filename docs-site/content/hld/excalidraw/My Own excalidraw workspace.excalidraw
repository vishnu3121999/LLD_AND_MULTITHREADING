    {
      "id": "udhfIFRxLoMTvUMSMvKDR",
      "type": "text",
      "x": -5269.961117663655,
      "y": 1110.1417142337589,
      "width": 638.939453125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
