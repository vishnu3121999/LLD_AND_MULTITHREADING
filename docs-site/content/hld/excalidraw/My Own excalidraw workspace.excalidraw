    {
      "id": "HmbJn2fTmSNjzjH4EpBiq",
      "type": "text",
      "x": -91.33827924401191,
      "y": 1215.454184747267,
      "width": 938.9237060546875,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2X",
      "roundness": null,
      "seed": 2021835800,
      "version": 509,
      "versionNonce": 1643841384,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761478121955,
      "link": null,
      "locked": false,
      "text": "Funtional Requirements:\n- Upload\n- Download\n- Automatic Sync\n- Should be able to share files with other users\n- Desktop/Mobile App & Web App\n\nOut Of Scope:\n- Able to view files without downloading - TODO\n- Able to colaborate simulatneously on files like google docs - TODO\n\nNon-Functional Requirements:\n- Availability > Consistency\n- Support large files <= 50GB\n    - Resumable uploads\n- Low latency uploads & downloads (as low as possible) ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Funtional Requirements:\n- Upload\n- Download\n- Automatic Sync\n- Should be able to share files with other users\n- Desktop/Mobile App & Web App\n\nOut Of Scope:\n- Able to view files without downloading - TODO\n- Able to colaborate simulatneously on files like google docs - TODO\n\nNon-Functional Requirements:\n- Availability > Consistency\n- Support large files <= 50GB\n    - Resumable uploads\n- Low latency uploads & downloads (as low as possible) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
