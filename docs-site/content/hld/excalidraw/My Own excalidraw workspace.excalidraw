    {
      "id": "WPSMJNt_ic1tDGYAx0uQJ",
      "type": "text",
      "x": 10714.589789665366,
      "y": 336.2339974496847,
      "width": 594,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7A",
