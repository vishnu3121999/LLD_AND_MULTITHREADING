      "boundElements": [],
      "updated": 1773487817683,
      "link": null,
      "locked": false,
      "text": "SELECT AVG(value) AS avg_cpu\nFROM metrics\nWHERE name = 'cpu_usage'\nAND labels->>'region' = 'us-east'\nAND ts >= NOW() - INTERVAL '5 minutes'\nHAVING AVG(value) > 0.9;",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT AVG(value) AS avg_cpu\nFROM metrics\nWHERE name = 'cpu_usage'\nAND labels->>'region' = 'us-east'\nAND ts >= NOW() - INTERVAL '5 minutes'\nHAVING AVG(value) > 0.9;",
