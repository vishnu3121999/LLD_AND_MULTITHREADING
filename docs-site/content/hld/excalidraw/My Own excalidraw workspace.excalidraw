      "boundElements": [],
      "updated": 1783078093578,
      "link": null,
      "locked": false,
      "text": "SELECT\n    itemId,\n    SUM(count) AS total_count\nFROM EventsHourly\nWHERE flooredHourTime >= NOW() - INTERVAL '24 hours'\nGROUP BY itemId\nORDER BY total_count DESC\nLIMIT 10;",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT\n    itemId,\n    SUM(count) AS total_count\nFROM EventsHourly\nWHERE flooredHourTime >= NOW() - INTERVAL '24 hours'\nGROUP BY itemId\nORDER BY total_count DESC\nLIMIT 10;",
      "autoResize": true,
      "lineHeight": 1.25
    },
