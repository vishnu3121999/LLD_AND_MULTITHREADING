    {
      "id": "tLNp1pi2yelMM4bcUY_jW",
      "type": "text",
      "x": -401.5939472045684,
      "y": -522.737455784245,
      "width": 2009.040665617122,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 665351448,
      "version": 968,
      "versionNonce": 1477649256,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783678690725,
      "link": null,
      "locked": false,
      "text": "1.Advertisers & Publishers register on Ad network. \n    Advertisers create campaigns with set of ads. \n    Publishers do Ad network integration to accept ads on their webpages.\n2.Client accesses publishers website. Publishers send its website content along with Ad script\n3.Client's browser executes the Ad script i.e it makes a call to Ad network to fetch ads. \n    Ad network finds the best match Ad & returns it\n4.Client clicks on some Ad. Ad network receives that click event , logs it internally & does 302 redirect to advertisers website\n5.Client accesses advertisers website upon redirect\n6. Advertisers can view analytics about their ads ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.Advertisers & Publishers register on Ad network. \n    Advertisers create campaigns with set of ads. \n    Publishers do Ad network integration to accept ads on their webpages.\n2.Client accesses publishers website. Publishers send its website content along with Ad script\n3.Client's browser executes the Ad script i.e it makes a call to Ad network to fetch ads. \n    Ad network finds the best match Ad & returns it\n4.Client clicks on some Ad. Ad network receives that click event , logs it internally & does 302 redirect to advertisers website\n5.Client accesses advertisers website upon redirect\n6. Advertisers can view analytics about their ads ",
      "autoResize": false,
      "lineHeight": 1.25
    },
